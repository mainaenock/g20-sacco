{
  "name": "g20-sacco-digital-branch",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cf:check": "vinext check",
    "cf:build": "vinext build",
    "cf:dev": "vinext dev",
    "cf:deploy": "vinext deploy",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^26.1.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "^5.9.2",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  },
  "type": "module"
}
